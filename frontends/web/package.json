{
  "private": true,
  "name": "bitboxapp",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@reown/walletkit": "1.2.10",
    "@walletconnect/core": "2.21.7",
    "@walletconnect/types": "2.21.7",
    "@walletconnect/utils": "2.21.7",
    "flag-icons": "7.5.0",
    "i18next": "25.7.3",
    "lightweight-charts": "4.1.4",
    "qr-scanner": "1.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "16.5.0",
    "react-select": "5.10.2",
    "request-address": "0.0.11",
    "wouter": "3.11.0"
  },
  "overrides": {
    "viem@2.31.0": {
      "ws": "8.21.0"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "scripts": {
    "check-licenses": "node ./scripts/check-licenses.mjs",
    "generate-licenses": "node ./scripts/generate-licenses.mjs",
    "dev": "npm run start",
    "start": "vite --cors",
    "build": "npm run typescript && vite build",
    "lint": "npm run typescript && eslint ./src ./tests",
    "postlint": "node ./scripts/sort-json.mjs ./src/locales --check",
    "fix": "npm run typescript && eslint ./src ./tests --fix",
    "postfix": "node ./scripts/sort-json.mjs ./src/locales",
    "lint-debug": "eslint ./src --inspect-config",
    "typescript": "tsc -p tsconfig.json",
    "test": "vitest",
    "test-e2e": "playwright test",
    "preview": "vite preview --port 8080",
    "serve": "npm run build && npm run preview"
  }
}
