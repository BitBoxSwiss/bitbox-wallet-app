<?xml version="1.0" encoding="utf-8"?>
<!-- Older launchers use minWidth/minHeight and initialLayout as fallbacks. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/price_widget_description"
    android:initialLayout="@layout/price_widget"
    android:minWidth="250dp"
    android:minResizeWidth="250dp"
    android:minHeight="220dp"
    android:minResizeHeight="220dp"
    android:previewLayout="@layout/price_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
