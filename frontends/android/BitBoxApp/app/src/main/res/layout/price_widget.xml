<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/price_widget_background"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <ImageView
            android:id="@+id/widget_coin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_btc" />
        <TextView
            android:id="@+id/widget_pair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:text="@string/price_widget_empty"
            android:textColor="@color/widget_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/price_widget_empty"
            android:textColor="@color/widget_secondary"
            android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <!-- Android 7 uses the explicit text size; Android 8+ also scales to fit. -->
        <TextView
            android:id="@+id/widget_price"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="30sp"
            android:text="@string/price_widget_empty"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            tools:ignore="UnusedAttribute" />
        <TextView
            android:id="@+id/widget_unavailable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/price_widget_unavailable"
            android:textSize="13sp"
            android:textColor="@color/widget_secondary"
            android:visibility="gone" />
    </FrameLayout>
    <ImageView
        android:id="@+id/widget_chart"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:contentDescription="@string/price_widget_chart"
        android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:id="@+id/widget_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="12dp"
            android:contentDescription="@string/price_widget_previous"
            android:src="@drawable/widget_previous"
            android:visibility="invisible" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="@string/app_name"
            android:src="@drawable/widget_logo" />
        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="12dp"
            android:contentDescription="@string/price_widget_next"
            android:src="@drawable/widget_next"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
