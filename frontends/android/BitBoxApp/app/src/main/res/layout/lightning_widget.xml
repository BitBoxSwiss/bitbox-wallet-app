<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lightning_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/price_widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/lightning_widget_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textColor="@color/widget_text"
        android:textDirection="ltr"
        android:textSize="11sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/lightning_widget_qr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lightning_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/lightning_widget_empty"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/lightning_widget_logo"
        android:layout_width="18dp"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_logo" />
</LinearLayout>
